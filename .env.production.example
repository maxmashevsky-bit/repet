# Copy to .env.production on the server. Never commit real configuration/secrets.
APP_DOMAIN=repet.example.com
# Separate hostname, preferably a separate registrable domain for uploaded HTML.
HTML_DOMAIN=lessons.example.net
ACME_EMAIL=admin@example.com
SMTP_ADDR=smtp.example.com:587
SMTP_FROM=no-reply@example.com
SMTP_USER=no-reply@example.com
SECRETS_DIR=./secrets
REPET_VERSION=local
