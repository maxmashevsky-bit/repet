{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repet.local/schemas/exercise-v2.json",
  "title": "Repet public exercise (no answer keys)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "prompt",
    "options",
    "difficulty",
    "position"
  ],
  "properties": {
    "media": { "type": "array", "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["asset_id", "alt"], "properties": { "asset_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }, "alt": { "type": "string", "minLength": 1, "maxLength": 1000 } } } },
    "hint_count": { "type": "integer", "minimum": 0, "maximum": 5 },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "kind": {
      "enum": [
        "text",
        "numeric",
        "long_text",
        "single_choice",
        "multiple_choice",
        "number_line",
        "grid_select",
        "matching",
        "ordering",
        "geometry"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "options": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "config": {
      "type": "object"
    }
  },
  "definitions": {
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    },
    "number_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "step"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "max": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "grid_select": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "columns"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "left": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/item"
          },
          "minItems": 2,
          "maxItems": 8
        },
        "right": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/item"
          },
          "minItems": 2,
          "maxItems": 8
        }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/item"
          },
          "minItems": 2,
          "maxItems": 12
        }
      }
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "rows",
            "columns"
          ],
          "properties": {
            "mode": {
              "const": "point"
            },
            "rows": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "columns": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "rows",
            "columns",
            "points"
          ],
          "properties": {
            "mode": {
              "const": "connect"
            },
            "rows": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "columns": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/point"
              },
              "minItems": 2,
              "maxItems": 12
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "rows",
            "columns",
            "points",
            "objects"
          ],
          "properties": {
            "mode": {
              "const": "select"
            },
            "rows": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "columns": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/point"
              },
              "minItems": 2,
              "maxItems": 12
            },
            "objects": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label",
                      "kind",
                      "point_ids"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "kind": {
                        "const": "segment"
                      },
                      "point_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$"
                        },
                        "minItems": 2,
                        "maxItems": 2,
                        "uniqueItems": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label",
                      "kind",
                      "point_ids"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "kind": {
                        "const": "polygon"
                      },
                      "point_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$"
                        },
                        "minItems": 3,
                        "maxItems": 12,
                        "uniqueItems": true
                      }
                    }
                  }
                ]
              },
              "minItems": 2,
              "maxItems": 12
            }
          }
        }
      ]
    },
    "variants": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "text",
                "numeric",
                "long_text"
              ]
            },
            "options": {
              "maxItems": 0
            },
            "config": {
              "$ref": "#/definitions/empty"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "single_choice",
                "multiple_choice"
              ]
            },
            "options": {
              "minItems": 2,
              "maxItems": 12
            },
            "config": {
              "$ref": "#/definitions/empty"
            }
          }
        },
        {
          "required": [
            "config"
          ],
          "properties": {
            "kind": {
              "const": "number_line"
            },
            "options": {
              "maxItems": 0
            },
            "config": {
              "$ref": "#/definitions/number_line"
            }
          }
        },
        {
          "required": [
            "config"
          ],
          "properties": {
            "kind": {
              "const": "grid_select"
            },
            "options": {
              "maxItems": 0
            },
            "config": {
              "$ref": "#/definitions/grid_select"
            }
          }
        },
        {
          "required": [
            "config"
          ],
          "properties": {
            "kind": {
              "const": "matching"
            },
            "options": {
              "maxItems": 0
            },
            "config": {
              "$ref": "#/definitions/matching"
            }
          }
        },
        {
          "required": [
            "config"
          ],
          "properties": {
            "kind": {
              "const": "ordering"
            },
            "options": {
              "maxItems": 0
            },
            "config": {
              "$ref": "#/definitions/ordering"
            }
          }
        },
        {
          "required": [
            "config"
          ],
          "properties": {
            "kind": {
              "const": "geometry"
            },
            "options": {
              "maxItems": 0
            },
            "config": {
              "$ref": "#/definitions/geometry"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/variants"
    }
  ]
}
